---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import landscape from '../assets/landscape.webp?url';
import portrait from '../assets/photos/hero-960.jpg';
import { publicUrl, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const canonical = publicUrl(path);
const socialImage = publicUrl(portrait.src);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.profession,
  url: publicUrl('/'),
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6faff" />
    {path === '/' && <link rel="preload" as="image" href={landscape} type="image/webp" fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !canonical) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} | ${site.profession}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:width" content={String(portrait.width)} />
      <meta property="og:image:height" content={String(portrait.height)} />
      <meta property="og:image:alt" content={`Портрет психолога: ${site.name}`} />
    </>}
    <link rel="icon" href={import.meta.env.BASE_URL + 'favicon.svg'} type="image/svg+xml" />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />}
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
