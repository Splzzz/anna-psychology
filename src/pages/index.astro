---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Topics from '../components/Topics.astro';
import Details from '../components/Details.astro';
import Footer from '../components/Footer.astro';
import Booking from '../components/Booking.astro';
---
<Base>
  <a class="skip" href="#main">Перейти к содержанию</a>
  <Header/>
  <main id="main">
    <Hero/>
    <Topics/>
    <Details/>
  </main>
  <Footer/>
  <Booking/>
</Base>
<script>
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      let cardIndex = 0;
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const block = entry.target as HTMLElement;
        observer.unobserve(block);
        if (block.closest('section')?.matches(':target, :has(:target)') || block.matches(':focus-within')) continue;
        if (block.matches('.topics-grid > article')) {
          block.style.setProperty('--reveal-delay', `${cardIndex++ * 60}ms`);
        }
        block.classList.add('reveal-once');
        block.addEventListener('animationend', () => block.classList.remove('reveal-once'), { once: true });
      }
    });
    document.querySelectorAll('[data-reveal]').forEach(block => observer.observe(block));
  }
</script>
