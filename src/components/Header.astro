---
import { site } from '../data/site';
import { navigation } from '../data/home';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---
<header class="header">
  <div class="wrap header-inner">
    <Brand />
    <nav id="navigation" aria-label="Основная навигация">
      {navigation.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href={site.contacts.primary?.href ?? '#booking'} data-booking={!site.contacts.primary || undefined} class="header-cta">{site.cta.book}<Icon name="diagonal" size={15}/></a>
      <button type="button" class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Открыть меню"><Icon name="menu" size={23} /></button>
    </div>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#navigation');
  function setMenu(open: boolean) {
    menu?.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    nav?.classList.toggle('open', open);
  }
  menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', () => setMenu(false));
  document.addEventListener('click', e => { if (e.target instanceof Node && !menu?.contains(e.target) && !nav?.contains(e.target)) setMenu(false); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { setMenu(false); menu.focus(); }
  });
  document.addEventListener('focusin', e => {
    if (e.target instanceof Node && !nav?.contains(e.target) && !menu?.contains(e.target)) setMenu(false);
  });
  matchMedia('(min-width: 1051px)').addEventListener('change', () => setMenu(false));
  // The navigation follows the toggle in tab order on narrow screens.
  menu?.addEventListener('keydown', e => {
    if (e.key === 'Tab' && !e.shiftKey && menu.getAttribute('aria-expanded') === 'true') { e.preventDefault(); nav?.querySelector('a')?.focus(); }
  });
</script>
<style>
  .header { position: sticky; z-index: 5; top: 0; background: #fcfdfff7; border-bottom: 1px solid #d4e1e9; }
  .header-inner, .header-actions, nav, .header-cta { display: flex; align-items: center; }
  .header-inner { justify-content: space-between; gap: 16px; min-height: 76px; }
  nav { gap: clamp(16px,2.3vw,38px); }
  nav a { padding-block: 14px; font-size: 13px; font-weight: 540; text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { nav a:hover { text-decoration: underline; text-underline-offset: 5px; } }
  .header-actions { gap: 9px; }
  .header-cta { gap: 16px; min-height: 40px; padding: 8px 18px; background: #eaf2f8; border: 1px solid #becfdd; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 650; transition: background .2s; }
  @media (hover: hover) and (pointer: fine) { .header-cta:hover, .menu-toggle:hover { background: #dbe9f3; } }
  .menu-toggle { display: none; }
  @media(max-width: 1050px) {
    .header-inner { min-height: 66px; }
    .menu-toggle { display: grid; place-items: center; border: 0; border-radius: 5px; background: transparent; height: 44px; width: 44px; }
    nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fcfdff; padding: 8px 5.5% 18px; border-block: 1px solid #d4e1e9; box-shadow: 0 9px 20px #203f5d13; }
    nav.open { display: grid; gap: 0; }
    nav a { padding: 12px 0; }
  }
  @media(max-width: 430px) {
    .header-inner { gap: 4px; min-height: 61px; }
    .header-cta { padding: 8px 10px; font-size: 12px; gap: 6px; min-height: 36px; }
    .header-actions { gap: 1px; } .menu-toggle { width: 35px; }
  }
  @media(max-width: 360px) {
    .header-inner { width: calc(100% - 24px); }
    .header-cta :global(svg) { display: none; }
  }
</style>
