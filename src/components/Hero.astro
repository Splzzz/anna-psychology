---
import Icon from './Icon.astro';
import Leaf from './Leaf.astro';
import { site, rubles } from '../data/site';
import { introduction as intro } from '../data/home';
import scenery from '../assets/landscape.webp?url';
import small from '../assets/photos/hero-480.webp?url';
import medium from '../assets/photos/hero-720.webp?url';
import large from '../assets/photos/hero-960.webp?url';
import fallback from '../assets/photos/hero-720.jpg?url';
---
<section class="hero" aria-labelledby="welcome" style={`--scenery: url("${scenery}")`}>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{intro.label}</p>
      <h1 id="welcome">{intro.title[0]}<br/>{intro.title[1]}<br/><em>{intro.title[2]}<svg viewBox="0 0 300 15" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12Q130 -2 296 6M27 13Q150 2 247 8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></em></h1>
      <p class="intro">Я {site.name}, психолог. {intro.body}</p>
      <div class="hero-actions">
        <a class="button" href={site.contacts.primary?.href ?? '#booking'} data-booking={!site.contacts.primary || undefined}>{site.cta.first}<Icon name="arrow"/></a>
        <a class="learn" href="#process">{site.cta.details}<Icon name="down" size={15}/></a>
      </div>
      <ul class="facts">
        <li><Icon name="globe" size={16}/>Онлайн по всей России</li><li><Icon name="clock" size={16}/>{site.pricing.minutes} минут</li><li><Icon name="tag" size={16}/>Первая встреча — {rubles(site.pricing.first)}</li>
      </ul>
    </div>
    <div class="photo-space">
      <figure class="print">
        <picture><source type="image/webp" srcset={`${small} 480w, ${medium} 720w, ${large} 960w`} sizes="(max-width: 620px) 34vw, (max-width: 1024px) 31vw, 365px"/><img src={fallback} width="720" height="960" fetchpriority="high" alt="Анна у окна в светлой комнате, смотрит в камеру"/></picture>
        <figcaption><span>{site.name}</span><i></i><small>Ваш психолог</small><Leaf width={29}/></figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; isolation: isolate; background: #eaf3fc; overflow: hidden; }
  .hero::before { content: ""; position: absolute; z-index: -1; inset: 0; background-image: linear-gradient(95deg, #f4f8fc9c 0%, #f4f8fc88 40%, #eff6fa16 70%), var(--scenery); background-size: 100% 100%; background-position: center bottom; }
  .hero-grid { display: grid; grid-template-columns: 1.23fr .9fr; gap: 4%; align-items: center; padding-block: clamp(36px,3vw,54px) clamp(42px,3.55vw,63px); }
  .hero h1 { font-size: clamp(52px, 4.95vw, 78px); font-weight: 550; letter-spacing: -.044em; line-height: .99; margin-block: 23px 24px; }
  .hero h1 em, .topics-heading em { font-weight: 500; }
  .hero h1 em { position: relative; color: #4b7599; }
  .hero h1 em svg { color: #8caec8; position: absolute; left: 0; width: 102%; height: 11px; bottom: -4px; }
  @media (prefers-reduced-motion: no-preference) {
    .hero h1 em svg { animation: underline-in 520ms ease-out; }
  }
  @keyframes underline-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  .intro { font-size: clamp(14px, 1.06vw, 16px); line-height: 1.67; max-width: 536px; color: #405970; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 26px; }
  .learn { display: inline-flex; align-items: center; gap: 8px; font-weight: 580; padding: 10px 0; font-size: 13px; text-underline-offset: 5px; text-decoration-color: #92a8b9; }
  @media (hover: hover) and (pointer: fine) { .learn:hover { text-decoration-color: currentColor; } }
  .facts { display: flex; align-items: center; flex-wrap: wrap; gap: 9px 16px; margin: 27px 0 0; padding: 0; list-style: none; color: #385773; font-size: 11.5px; font-weight: 550; }
  .facts li { display: flex; align-items: center; gap: 6px; }
  .facts li + li { padding-left: 14px; border-left: 1px solid #a9bdcc; }
  .photo-space { display: grid; place-items: center; position: relative; align-self: stretch; align-items: center; }
  .photo-space::before { content: ""; position: absolute; width: 96%; aspect-ratio: 1; max-width: 490px; border: 1px solid #a0bace94; border-radius: 48% 52% 55% 45%; transform: rotate(-22deg); }
  .print { width: clamp(282px, 26.2vw, 398px); position: relative; transform: rotate(3deg); padding: 12px 12px 0; background: #fffefa; box-shadow: 2px 9px 23px #28496228, 0 1px 4px #516b7f14; }
  .print::before { content: ""; position: absolute; z-index: 1; top: -11px; left: 35%; width: 30%; height: 28px; background: #d7d4bbbd; transform: rotate(-8deg); clip-path: polygon(0 2%,97% 0,99% 12%,96% 19%,100% 29%,97% 43%,100% 57%,96% 69%,100% 80%,98% 89%,100% 99%,0 100%,2% 88%,0 77%,2% 68%,0 52%,2% 33%,0 20%,2% 13%); }
  .print picture { display: block; }
  .print img { width: 100%; height: auto; aspect-ratio: 1 / 1.06; object-fit: cover; object-position: 50% 49%; }
  figcaption { display: flex; align-items: center; gap: 12px; min-height: 58px; padding: 2px 8px 4px; color: #47667f; }
  figcaption span { font: italic 500 34px/1 var(--serif); }
  figcaption i { height: 1px; width: 25px; background: #9babaf; }
  figcaption small { font-size: 11px; letter-spacing: .03em; } figcaption :global(svg) { margin-left: auto; opacity: .8; transform: rotate(19deg); }
  @media(max-width: 1050px) and (min-width: 621px) {
    .hero-grid { grid-template-columns: 1.35fr .85fr; gap: 1.5%; }.hero h1 { font-size: clamp(40px,5.3vw,58px); }
    .print { width: 87%; padding: 9px 9px 0; } figcaption { min-height: 48px; gap: 8px; }
    .facts { gap: 8px 12px; } .facts li + li { padding-left: 0; border: 0; } .hero-actions { gap: 5px 16px; }
  }
  @media(max-width: 620px) {
    .hero-grid { grid-template-columns: minmax(0,.95fr) minmax(0,1.4fr); gap: 0 18px; padding-block: 30px 40px; }
    .hero-copy { display: contents; }
    .hero .eyebrow, .hero h1, .hero-actions, .facts { grid-column: 1 / -1; }
    .hero .eyebrow { font-size: 8.5px; gap: 8px; } .hero .eyebrow::before { width: 20px; }
    .hero h1 { grid-row: 2; font-size: clamp(35px,8.8vw,54px); line-height: 1.02; margin-block: 17px 26px; }
    .photo-space { grid-column: 1; grid-row: 3; } .photo-space::before { display: none; }
    .print { width: 95%; padding: 5px 5px 0; transform: rotate(-3deg); } .print::before { height: 13px; top: -6px; }
    figcaption { min-height: 27px; gap: 3px; padding: 2px; } figcaption span { font-size: 18px; } figcaption small { font-size: 8px; } figcaption i { width: 6px; } figcaption :global(svg) { display: none; }
    .intro { grid-column: 2; grid-row: 3; font-size: 13px; line-height: 1.6; }
    .hero-actions { margin-top: 21px; gap: 6px 16px; } .hero-actions .button { font-size: 12px; gap: 10px; }
    .facts { margin-top: 16px; gap: 6px 12px; font-size: 10.5px; } .facts li + li { padding-left: 0; border-left: 0; }
    .hero::before { background-size: auto 100%, auto 100%; }
  }
</style>
