---
import { topics } from '../data/home';
interface Props { kind: typeof topics[number]['art']; }
const { kind } = Astro.props;
---
<svg width="80" height="65" viewBox="0 0 74 60" fill="none" aria-hidden="true">
  <defs><radialGradient id={`wash-${kind}`} cx="42%" cy="55%" r="62%"><stop stop-color="#c2dceb"/><stop offset=".72" stop-color="#d7e8f2"/><stop offset="1" stop-color="#e6f0f6" stop-opacity=".35"/></radialGradient></defs>
  <path d="M6 35C7 23 14 12 30 10c12-3 27 0 34 9 7 11 1 26-10 31-14 6-26 3-40-2C7 45 4 40 6 35Z" fill={`url(#wash-${kind})`} opacity=".85"/>
  <g stroke="#50728d" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    {kind === 'waves' && <>
      <path d="M6 33c6 1 12-1 17-8 7-10 14-12 18-8 4 4 1 10-3 10 3-4-1-5-4-1-6 12 7 17 17 12 5-3 8-5 15-3"/>
      <path d="M6 40c7 1 14-3 18-8m-8 14c6 0 10-4 14-6 5-1 9 7 21 3 6-2 10-5 16-3m-16-9 5-2m-41-4 3-3"/>
    </>}
    {kind === 'cloud' && <>
      <path d="M17 34c-9 1-10-10-2-13 0-9 11-12 16-6 5-10 20-5 20 5 9-2 16 9 9 14-4 4-11 2-16 3"/>
      <path d="M18 32c8-4 23-5 27 0 3 5-9 10-16 9-9-2-2-9 5-7 8 3 4 15 13 15 3 0 6-2 8-4m-34-7-5 2"/>
    </>}
    {kind === 'path' && <>
      <path d="M35 49V20m4 29V20M30 15l-15 1-6 5 7 4 17-2m7-5 17-2 7-5-8-3-16 2m-7 0V7l6-1v9l-22 3m30 24 5-2m-24 7c4-2 14-2 18 0"/>
      <path d="m23 22 7-1m16-9 8-1M12 50c5-4 8-3 11-4m33-9 4-2"/>
    </>}
    {kind === 'sprout' && <>
      <path d="M37 48c-2-13-1-28 8-37M37 39C24 41 17 34 16 22c13-1 21 4 21 17Zm0-7c2-12 9-18 22-17-2 12-10 19-22 17ZM22 27l13 11m4-8 14-10m-28 29c6-3 19-3 25-1"/>
    </>}
    {kind === 'stone' && <>
      <path d="M14 43c4-5 13-8 24-7 12 0 22 3 22 8s-13 7-26 7-25-3-20-8Zm6-14c4-5 10-7 19-6 8 0 17 3 16 7-1 5-13 6-20 6-8 0-18-2-15-7Zm8-12c0-5 5-8 11-8 6 0 10 4 10 7 0 4-5 7-11 7-5 0-10-2-10-6Z"/>
      <path d="M25 45c6 2 14 2 20 1M31 31h8"/>
    </>}
    {kind === 'heart' && <>
      <path d="M57 24c2-12-13-17-21-6-7-12-22-6-21 5 0 8 12 19 23 26 2-7 12-14 17-20m-35-8c0-4 4-7 8-6"/>
      <path d="M10 38c10 3 20-9 29-7 8 3 1 10-5 8-7-4 8-12 18-10l9 1"/>
    </>}
  </g>
</svg>
