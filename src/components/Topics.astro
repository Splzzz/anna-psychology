---
import { topics } from '../data/home';
import TopicArt from './TopicArt.astro';
---
<section id="topics" class="topics" aria-labelledby="topics-title">
  <div class="wrap">
    <div class="section-heading"><span class="eyebrow">Направления работы</span><h2 id="topics-title">С чем можно ко мне <em>обратиться</em></h2></div>
    <div class="topics-grid">{topics.map(topic => <article data-reveal><TopicArt kind={topic.art}/><h3>{topic.title}</h3><p>{topic.text}</p></article>)}</div>
  </div>
</section>
<style>
  .topics { padding-block: clamp(38px,3.3vw,55px) clamp(58px,6vw,100px); background: #fcfdfe; }
  .section-heading { text-align: center; }
  .section-heading .eyebrow::after { content: ''; width: 28px; height: 1px; background: #829fb4; }
  h2 { font-size: clamp(38px,3.65vw,58px); line-height: 1.06; letter-spacing: -.04em; margin: 13px 0 clamp(26px,2.7vw,40px); }
  h2 em { font-weight: 500; color: #547791; }
  .topics-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; }
  article { padding: 23px 26px 27px; background: linear-gradient(120deg,#f5f9fc,#eff5fa); border-radius: 12px; border: 1px solid #d5e2eb; }
  article:nth-child(3n + 2) { background: linear-gradient(120deg,#f4f7fa,#eff4f8); }
  @media (hover: hover) and (pointer: fine) {
    article:hover {
      border-color: #a7c2d5;
      box-shadow: inset 0 0 0 100vmax rgb(164 200 226 / 10%), 0 4px 14px rgb(53 86 111 / 8%);
    }
    @media (prefers-reduced-motion: no-preference) {
      article { transition: border-color .18s ease, box-shadow .18s ease; }
    }
  }
  article :global(svg) { display: block; margin: -3px 0 8px -3px; }
  h3 { font-weight: 600; font-size: clamp(26px,2vw,32px); letter-spacing: -.035em; margin: 0 0 8px; }
  article p { font-size: 16px; line-height: 1.5; color: #344f65; max-width: 43ch; }
  @media(max-width: 820px) { .topics-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 560px) { .topics-grid { grid-template-columns: 1fr; gap: 10px; } article { display: grid; grid-template-columns: 52px 1fr; gap: 4px 12px; padding: 18px 15px; } article :global(svg) { width: 52px; height: auto; margin: 0; grid-row: span 2; } h3 { margin: 0; } article p { font-size: 15px; } }
</style>
