---
import { site, rubles } from '../data/site';
import Icon from './Icon.astro';
import Leaf from './Leaf.astro';
---
{!site.contacts.primary && <dialog id="booking" aria-labelledby="booking-title" aria-describedby="booking-message">
  <button type="button" class="close" aria-label="Закрыть окно"><Icon name="close" /></button>
  <Leaf width={38}/>
  <h2 id="booking-title">Первая встреча</h2>
  <p class="meeting">Онлайн · {site.pricing.minutes} минут · {rubles(site.pricing.first)}</p>
  <p id="booking-message">Запись пока не открыта. Когда Анна подключит свой канал связи, здесь можно будет написать ей и выбрать время встречи.</p>
  <a class="button" href="#prices">Посмотреть условия <Icon name="arrow"/></a>
</dialog>}
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#booking');
  if (dialog) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-booking]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', dialog.id);
      link.addEventListener('click', e => {
        e.preventDefault();
        dialog.showModal();
      });
    });
    dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('a')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', e => {
      const bounds = dialog.getBoundingClientRect();
      if (e.target === dialog && (e.clientX < bounds.left || e.clientX > bounds.right || e.clientY < bounds.top || e.clientY > bounds.bottom)) dialog.close();
    });
  }
</script>
<style>
  dialog { width: min(425px,calc(100% - 32px)); max-height: 90svh; padding: 32px; border: 1px solid var(--line); border-radius: 15px; color: var(--ink); background: #f8fbfe; box-shadow: 0 24px 70px #183e6626; }
  dialog::backdrop { background: #14314f60; backdrop-filter: blur(3px); }
  dialog:target:not([open]) { display: block; position: fixed; inset: 0; margin: auto; height: fit-content; z-index: 8; }
  dialog:target:not([open]) button { display: none; }
  .close { position: absolute; right: 12px; top: 12px; display: grid; place-items: center; width: 40px; height: 40px; background: transparent; border: 1px solid #cad9e3; border-radius: 50%; }
  .close { transition: background-color .18s; }
  .close:active { background-color: #dbe9f3; }
  @media (hover: hover) and (pointer: fine) { .close:hover { background-color: #dbe9f3; } }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open], dialog[open]::backdrop { animation: booking-in 170ms ease-out; }
  }
  @keyframes booking-in { from { opacity: 0; } to { opacity: 1; } }
  h2 { font-size: 42px; margin-top: 9px; }
  p { color: var(--muted); font-size: 14px; }
  .meeting { margin: 8px 0 18px; font-weight: 600; }
  .button { margin-top: 20px; }
</style>
