---
import { site } from '../data/site';
import Leaf from './Leaf.astro';
---
<a class="brand" href={import.meta.env.BASE_URL} title="На главную">
  <Leaf width={32} />
  <b>{site.name}</b>
  <span>{site.profession}</span>
</a>
<style>
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--blue); text-decoration: none; white-space: nowrap; }
  b { font: 600 34px/1 var(--serif); letter-spacing: -.045em; color: var(--ink); }
  span { font: 500 13px/1 var(--sans); border-inline-start: 1px solid #a9bbc7; padding-inline-start: 11px; }
  b, span { text-box: trim-both cap alphabetic; }
  @media (max-width: 430px) {
    .brand { gap: 5px; }
    .brand :global(svg) { width: 24px; }
    b { font-size: 29px; }
    span { font-size: 11px; padding-inline-start: 6px; }
  }
</style>
